{
  "info": {
    "_postman_id": "9d7e8b8e-7e4d-4f5e-9b72-github-profile-analyzer",
    "name": "GitHub Profile Analyzer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "username",
      "value": "octocat"
    }
  ],
  "item": [
    {
      "name": "Analyze GitHub Profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/analyze/{{username}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "analyze",
            "{{username}}"
          ]
        }
      }
    },
    {
      "name": "Get All Analyzed Profiles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profiles"
          ]
        }
      }
    },
    {
      "name": "Get Single Analyzed Profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles/{{username}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profiles",
            "{{username}}"
          ]
        }
      }
    }
  ]
}